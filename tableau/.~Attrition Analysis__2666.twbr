                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2444' id='81' type-v2='text' w='91557' x='6555' y='85945'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='14'>Insights and Recommendations</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='10556' id='82' type-v2='text' w='48779' x='1888' y='88611'>
                  <formatted-text>
                    <run fontcolor='#4e79a7' fontname='Tableau Semibold' fontsize='12'>Key Insights</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4e79a7' fontname='Tableau Medium'>•</run>
                    <run fontcolor='#000000' fontname='Tableau Medium'> Attrition is the highest in the early tenure group (0-2 years), indicating onboarding and early career support are critical</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4e79a7' fontname='Tableau Medium'>• </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>OverTime significantly increases attrition risk, with employees working overtime leaving at early 3x the rate</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4e79a7' fontname='Tableau Medium'>• </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Sales and entry-level roles show the highest attrition, driven by lower satisfaction and compensation</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4e79a7' fontname='Tableau Medium'>• </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Lower job satisfaction and income bands are strongly correlated with higher attrition and risk levels </run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#b4b4b4' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='5' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='10556' id='84' type-v2='text' w='47445' x='50667' y='88611'>
                  <formatted-text>
                    <run fontcolor='#e15759' fontname='Tableau Semibold' fontsize='12'>Recommendations</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759' fontname='Tableau Medium'>•</run>
                    <run fontcolor='#4e79a7' fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Enhance early tenure engagement through structured onboarding, memberships, and career path discussions</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759' fontname='Tableau Medium'>•</run>
                    <run fontcolor='#4e79a7' fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Review and optimize overtime practices,; ensure workload balance and employee well-being</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759' fontname='Tableau Medium'>•</run>
                    <run fontcolor='#4e79a7' fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Targeted retention programs for high-risk roles in Sales, R&amp;D, and HR, including career growth and recognition</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759' fontname='Tableau Medium'>•</run>
                    <run fontcolor='#4e79a7' fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Focus on improving job satisfaction through manager training, feedback loops, and competitive compensation </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#b4b4b4' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='5' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
