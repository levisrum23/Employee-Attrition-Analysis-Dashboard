                <zone fixed-size='34' forceUpdate='true' h='2444' id='80' type-v2='text' w='4667' x='1888' y='85945'>
                  <formatted-text>
                    <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='14'>4</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
