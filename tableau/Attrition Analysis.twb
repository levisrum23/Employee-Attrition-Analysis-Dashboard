      <aliases enabled='yes' />
      <column caption='Business Travel' datatype='string' name='[BusinessTravel]' role='dimension' type='nominal' />
      <column caption='Attrition Flag' datatype='integer' name='[Calculation_6144539882258432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Attrition] = &quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Attrition Rate' datatype='real' datatype-customized='true' name='[Calculation_6144539884032001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6144539882258432]) / COUNT([EmployeeNumber])' />
      </column>
      <column caption='tenure group' datatype='string' name='[Calculation_6144539887849475]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [YearsAtCompany] &lt;= 2 THEN &quot;0-2 years&quot;&#10;ELSEIF [YearsAtCompany] &lt;= 5 THEN &quot;3-5 years&quot;&#10;ELSEIF [YearsAtCompany] &lt;= 10 THEN &quot;6-10 years&quot;&#10;ELSE &quot;10+ years&quot;&#10;END' />
      </column>
      <column caption='age group' datatype='string' name='[Calculation_6144539888050180]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 30 THEN &quot;Under 30&quot;&#10;ELSEIF [Age] &lt;= 40 THEN &quot;30-40&quot;&#10;ELSEIF [Age] &lt;= 50 THEN &quot;41-50&quot;&#10;ELSE &quot;Above 50&quot;&#10;END' />
      </column>
      <column caption='income band' datatype='string' name='[Calculation_6144539888197637]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [MonthlyIncome] &lt; 3000 THEN &quot;Below 3K&quot;&#10;ELSEIF [MonthlyIncome] &lt; 5000 THEN &quot;3K - 5K&quot;&#10;ELSEIF [MonthlyIncome] &lt; 8000 THEN &quot;5K - 8K&quot;&#10;ELSEIF [MonthlyIncome] &lt; 12000 THEN &quot;8K - 12K&quot;&#10;ELSE &quot;Above 12K&quot;&#10;END' />
      </column>
      <column aggregation='CountD' caption='risk level' datatype='string' name='[Calculation_6144539888345094]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [OverTime] = &quot;Yes&quot; AND [JobSatisfaction] &lt;= 2 THEN &quot;High Risk&quot;&#10;ELSEIF [OverTime] = &quot;Yes&quot; OR [JobSatisfaction] &lt;= 2 OR [YearsAtCompany] &lt;= 2 THEN &quot;Medium Risk&quot;&#10;ELSE &quot;Low Risk&quot;&#10;END' />
      </column>
      <column caption='Filter Job Sat &lt;=2' datatype='integer' name='[Calculation_6144540003037191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [JobSatisfaction] &lt;=2 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Job Satisfaction Conversion' datatype='string' name='[Calculation_6144540102565901]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [JobSatisfaction]=1 THEN &apos;Low&apos;&#10;ELSEIF [JobSatisfaction]=2 THEN &apos;Medium&apos;&#10;ELSEIF [JobSatisfaction]=3 THEN &apos;High&apos;&#10;ELSE &apos;Very High&apos; END' />
      </column>
      <column caption='Label High Risk Employee' datatype='integer' name='[Calculation_6144540107415566]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Calculation_6144539888345094] = &quot;High Risk&quot; THEN [EmployeeNumber] END)' />
      </column>
